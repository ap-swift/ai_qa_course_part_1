# ============================================================
# AI QA Course: настройки LLM provider
# ============================================================
# Выберите один provider:
# mock | ollama | gigachat | yandexgpt | openai_compatible
#
# Рекомендуется для первых уроков:
# LLM_PROVIDER=mock
#
# Рекомендуется для локальных экспериментов без cloud API:
# LLM_PROVIDER=ollama
# ============================================================

LLM_PROVIDER=mock

# ----------------------------
# Mock provider
# ----------------------------
MOCK_MODE=strict

# ----------------------------
# Локальный provider Ollama
# ----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ----------------------------
# Provider GigaChat
# ----------------------------
GIGACHAT_API_KEY=your_gigachat_api_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

# ----------------------------
# Provider YandexGPT
# ----------------------------
YANDEX_API_KEY=your_yandex_cloud_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_MODEL_URI=gpt://your_folder_id/yandexgpt/latest

# ----------------------------
# OpenAI-compatible provider
# Используйте для совместимого endpoint, который юридически и технически
# доступен вам: DeepSeek, Qwen/DashScope-compatible endpoints,
# SiliconFlow, OpenRouter, Together AI, Fireworks AI, local servers, etc.
# ----------------------------
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=your_api_key_here
OPENAI_COMPATIBLE_MODEL=your_model_name_here
